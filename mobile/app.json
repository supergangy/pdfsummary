{
  "expo": {
    "name": "필기 요약",
    "slug": "pdfsummary",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "pdfsummary",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.supergangy.pdfsummary",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.supergangy.pdfsummary",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#182E5C"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#182E5C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "./plugins/withLocalhostHttp",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": "SUBQUERY (extensionItems, $extensionItem, SUBQUERY ($extensionItem.attachments, $attachment, ANY $attachment.registeredTypeIdentifiers UTI-CONFORMS-TO \"com.adobe.pdf\").@count == 1).@count == 1",
          "androidIntentFilters": [
            "*/*"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "강의를 녹음해 필기와 함께 들으려면 마이크를 써야 해요.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "노트에 사진을 붙이려면 사진을 골라야 해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
