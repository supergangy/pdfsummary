+    // pdfsummary patch: run queued main-thread work (redraws) at most once per vsync, right after the
+    // current frame. Before, a shared-value update during touch dispatch drew the canvas at once and the
+    // Reanimated frame drew it again, so the second swap blocked in dequeueBuffer (~7ms) and frames were
+    // dropped on 120Hz screens. Deferring everything to the next Choreographer frame instead halved the
+    // rate of Reanimated-driven updates (fling), so: drain after this frame (async message, not held by
+    // sync barriers), unless we already drew less than MIN_GAP ago; then wait for the next frame.
+    private static final long MIN_GAP_NANOS = 6_000_000L;
+    private long lastDrainNanos = 0;
+
+    private final Runnable drainNow = new Runnable() {
+        @Override
+        public void run() {
+            mainHandler.removeCallbacks(drainNow);
+            Choreographer.getInstance().removeFrameCallback(drainOnFrame);
+            lastDrainNanos = System.nanoTime();
+            notifyTaskReadyNative();
+        }
+    };
+
+    private final Choreographer.FrameCallback drainOnFrame = new Choreographer.FrameCallback() {
+        @Override
+        public void doFrame(long frameTimeNanos) {
+            drainNow.run();
+        }
+    };
+
+    private final Runnable scheduleDrain = new Runnable() {
+        @Override
+        public void run() {
+            if (System.nanoTime() - lastDrainNanos >= MIN_GAP_NANOS) {
+                Message m = Message.obtain(mainHandler, drainNow);
+                m.setAsynchronous(true);
+                mainHandler.sendMessage(m);
+            } else {
+                Choreographer.getInstance().postFrameCallback(drainOnFrame);
+                mainHandler.postDelayed(drainNow, 100); // no vsync coming (screen off etc.)
+            }
+        }
+    };
+
